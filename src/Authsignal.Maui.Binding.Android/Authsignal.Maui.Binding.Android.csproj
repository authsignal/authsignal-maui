<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <NativeAndroidDir>$(MSBuildThisFileDirectory)../../native/android/wrapper/build/</NativeAndroidDir>
    <Description>Native Android binding used by Authsignal.Maui. Reference Authsignal.Maui instead.</Description>
  </PropertyGroup>

  <ItemGroup>
    <AndroidLibrary Include="$(NativeAndroidDir)outputs/aar/wrapper-release.aar" />
    <AndroidLibrary Include="$(NativeAndroidDir)bundled/*.aar;$(NativeAndroidDir)bundled/*.jar" Bind="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Xamarin.AndroidX.Credentials" Version="1.6.0" />
    <PackageReference Include="Xamarin.AndroidX.Credentials.PlayServicesAuth" Version="1.6.0" />
    <PackageReference Include="Xamarin.AndroidX.DataStore.Preferences" Version="1.1.7" />
    <PackageReference Include="Xamarin.GooglePlayServices.Base" Version="118.10.0.1" />
    <PackageReference Include="Xamarin.Google.Android.Play.Integrity" Version="1.6.0" />
    <PackageReference Include="Xamarin.KotlinX.Coroutines.Android" Version="1.10.2.3" />
    <PackageReference Include="Xamarin.KotlinX.Coroutines.Play.Services" Version="1.10.2.3" />
    <PackageReference Include="Xamarin.KotlinX.Serialization.Json" Version="1.8.1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Xamarin.AndroidX.Activity.Ktx" Version="1.12.4.1" />
    <PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0" />
    <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.8.9.2" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.10.0.2" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.10.0.2" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" Version="2.10.0.2" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx.Android" Version="2.10.0.2" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel.Ktx" Version="2.10.0.2" />
    <PackageReference Include="Xamarin.AndroidX.SavedState.SavedState.Ktx" Version="1.4.0.2" />
  </ItemGroup>

</Project>
